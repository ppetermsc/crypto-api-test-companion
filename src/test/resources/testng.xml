<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Crypto API Test Suite" verbose="1">
    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <test name="Binance API Tests">
        <classes>
            <class name="tests.BinanceApiTests"/>
        </classes>
    </test>

    <test name="CoinGecko API Tests">
        <classes>
            <class name="tests.CoinGeckoApiTests"/>
        </classes>
    </test>

    <test name="Validation Tests">
        <classes>
            <class name="tests.ValidationTests"/>
        </classes>
    </test>
</suite>
